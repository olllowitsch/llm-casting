# S6-D REVIEW TEMPLATE. No automatic installation/start/boot activation.
# Approved normal-file SquashFS image and per-instance profile pin are mandatory.
[Unit]
Description=LLM Casting dedicated synthetic probe %i

[Service]
Type=exec
Slice=system.slice
User=llm-casting-probe
Group=llm-casting-probe
SupplementaryGroups=
RootImage=/var/lib/llm-casting-isolation-probe/%i/rootfs.squashfs
MountAPIVFS=yes
WorkingDirectory=/fixtures/output
BindReadOnlyPaths=/opt/llm-casting-isolation-probe/package:/opt/isolation
BindReadOnlyPaths=/var/lib/llm-casting-isolation-probe/%i/profile.json:/fixtures/profile.json
BindReadOnlyPaths=/var/lib/llm-casting-isolation-probe/%i/marker.json:/fixtures/marker.json
BindReadOnlyPaths=/var/lib/llm-casting-isolation-probe/%i/reference:/fixtures/reference
BindReadOnlyPaths=/var/lib/llm-casting-isolation-probe/%i/outside:/fixtures/outside
BindReadOnlyPaths=/var/lib/llm-casting-isolation-probe/%i/other:/fixtures/other
BindReadOnlyPaths=/sys/fs/cgroup:/sys/fs/cgroup
BindPaths=/var/lib/llm-casting-isolation-probe/%i/output:/fixtures/output
ReadWritePaths=/fixtures/output
InaccessiblePaths=/fixtures/other
Environment=LLM_CASTING_PROFILE_SHA256=REPLACE_WITH_REVIEWED_CANONICAL_PROFILE_HASH
ExecStart=/usr/bin/python3 -E -s -B /opt/isolation/probe.py --profile /fixtures/profile.json --expected-profile-sha256 ${LLM_CASTING_PROFILE_SHA256} --test-root /fixtures --with-child
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=128M
MemorySwapMax=0
CPUQuota=25%
TasksMax=16
RuntimeMaxSec=15s
TimeoutStopSec=2s
KillMode=control-group
SendSIGKILL=yes
Restart=no
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-casting-isolation-probe
LogRateLimitIntervalSec=1s
LogRateLimitBurst=10
